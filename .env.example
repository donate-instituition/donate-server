APP_ENV=local
# Use MONGODB_URI as a full override, or MONGODB_CLUSTER_URI + MONGODB_DATABASE.
# When MONGODB_DATABASE is empty, APP_ENV=production uses "prod"; other environments use "test".
MONGODB_URI=
MONGODB_CLUSTER_URI=mongodb://localhost:27017
MONGODB_DATABASE=test
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
PORT=3000
SERVICE_NAME=donate-server
SERVICE_VERSION=0.0.1
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
IDEMPOTENCY_TTL_MS=86400000
RABBITMQ_URL=amqp://donate:donate@localhost:5672
RABBITMQ_EXCHANGE=donate.jobs
# Local (donate-infra Docker). In production, point this at Upstash instead
# (rediss://default:<password>@<endpoint>.upstash.io:6379) — no code changes needed.
REDIS_URL=redis://:donate@localhost:6379
REDIS_KEY_PREFIX=donate:
EMAIL_SUPPORT_EMAIL=contato@elodoar.local
EMAIL_SUPPORT_PHONE=
EMAIL_PUBLIC_APP_URL=
EMAIL_ACCOUNT_ACTIVATION_URL=http://localhost:3000/auth/activate-account
EMAIL_BRAND_LOGO_URL=
EMAIL_BRAND_HERO_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl
STRIPE_SERVICE_FEE_BPS=0
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FCM_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
